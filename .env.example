# Copy to .env.local and fill in. .env.local is git-ignored.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the default model (liquid/lfm-3-1.7b:free)
# OPENROUTER_MODEL=

# Optional: the date "today", "last week" etc. are counted from.
# Leave unset to use 2025-09-21 (the last day in the data).
# "today" = the server's current date (UTC); or set a fixed YYYY-MM-DD.
# The dashboard's Update button re-runs every chart for this date.
# ANALYTICS_TODAY=
